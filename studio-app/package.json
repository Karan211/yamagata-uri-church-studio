{
  "name": "yamagata-uri-church-studio",
  "productName": "야마가타우리교회 스튜디오",
  "version": "1.3.0",
  "description": "야마가타우리교회 스튜디오 — 배경영상 · 성경 자막 · 동시통역 · 방송",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "sync": "rm -rf app && mkdir -p app && cp ../studio/*.html ../studio/*.js ../studio/*.css ../studio/*.png app/",
    "build": "npm run build:mac",
    "build:mac": "npm run sync && electron-packager . '야마가타우리교회 스튜디오' --app-bundle-id=church.yamagatauri.studio --out=dist --overwrite --ignore='^/dist' --ignore='^/build' --platform=darwin --arch=arm64 --icon=build/icon.icns --extend-info=build/extra.plist",
    "build:mac-intel": "npm run sync && electron-packager . '야마가타우리교회 스튜디오' --app-bundle-id=church.yamagatauri.studio --out=dist --overwrite --ignore='^/dist' --ignore='^/build' --platform=darwin --arch=x64 --icon=build/icon.icns --extend-info=build/extra.plist",
    "build:win": "npm run sync && electron-packager . '야마가타우리교회 스튜디오' --app-bundle-id=church.yamagatauri.studio --out=dist --overwrite --ignore='^/dist' --ignore='^/build' --platform=win32 --arch=x64 --icon=build/icon.ico",
    "build:all": "npm run build:mac && npm run build:mac-intel && npm run build:win"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "^33.2.0"
  }
}
